# Weights and Biases. Offline first, which is the shape POLICY.md, section 7 requires: the
# template ships WANDB_MODE=offline, and a training box with no egress needs no other value.
WANDB_API_KEY=
WANDB_ENTITY=            # the organisation or user entity runs are logged under
WANDB_PROJECT=vividly    # inert: src/vividly/eval/sinks.py passes project= explicitly, so an
                         # explicit argument always wins over this variable
WANDB_MODE=offline

# Optional overrides read by src/vividly/media/ffmpeg.py. The default is a lookup on PATH, so
# leave these unset unless a specific build is needed.
# VIVIDLY_FFMPEG=
# VIVIDLY_FFPROBE=

# The live-camera bring-up script, scripts/live_camera.py, reads the credentialed stream URL
# from this one variable when --url is not given (docs/LIVE_CAMERA.md). Never commit a value.
# REOLINK_RTSP_URL=
