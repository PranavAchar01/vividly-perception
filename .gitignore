# --- data and model artifacts: never in git ---
# The descend-then-negate pattern is load-bearing: a plain /data/ exclusion would make the
# .gitkeep negations dead, because git never descends into an excluded directory, so a fresh
# clone would not materialise the separation between the training trees and the
# evaluation-only tree that the training-path rule depends on.
/data/*
!/data/train_ok/
/data/train_ok/*
!/data/train_ok/.gitkeep
!/data/eval_only/
/data/eval_only/*
!/data/eval_only/.gitkeep
!/data/train_prototype/
/data/train_prototype/*
!/data/train_prototype/.gitkeep
# Weight blobs. configs/checkpoints/registry.yaml is committed. Root-anchored, and the
# comment must live on its own line: gitignore treats trailing text as part of the pattern.
/checkpoints/
work_dirs/
outputs/
wandb/
*.pth
*.onnx
*.plan
*.engine
*.zip
*.tar
*.tar.gz
*.mp4
*.avi
!tests/fixtures/*.mp4
# 1.3 KB of arithmetic weights, not a model: the re-ID backend's test graph. Regenerated by
# tests/fixtures/reid_synth/generate.py, digest asserted in tests/test_reid_backend.py.
!tests/fixtures/reid_synth/tiny_embedder.onnx
# final_models is the model record: its onnx files are the deliverable, so the global
# *.onnx rule above is negated for them. They are stored with Git LFS, which is how the
# detector weight clears the 100 MiB per-file limit.
!final_models/**/*.onnx

# --- brand: only the downscaled README marks are tracked ---
assets/brand/*
!assets/brand/vividly-square-black-rounded-1024.png
!assets/brand/vividly-square-black-96.png

# --- envs ---
.venv/
.venv-agpl/
.venv-curate/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# --- secrets and local state ---
.env
.env.local
.fetch_assets.log
.DS_Store

# Local pod backups (rsynced weights/results; never project content)
pod_backup/
